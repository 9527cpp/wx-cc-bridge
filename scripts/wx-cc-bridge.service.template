[Unit]
Description=wx-cc-bridge bridge service
After=network.target

[Service]
Type=simple
WorkingDirectory={{REPO}}
ExecStart={{PYTHON}} -m wx_cc_bridge.bridge
Environment=PYTHONPATH={{REPO}}/src
Environment=PYTHONUNBUFFERED=1
Environment=CLAUDE_BIN={{CLAUDE_BIN}}
Environment=PATH={{NODE_BIN_PREFIX}}{{HOME}}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=always
RestartSec=5

StandardOutput=append:{{LOG_DIR}}/bridge.log
StandardError=append:{{LOG_DIR}}/bridge.err.log

[Install]
WantedBy=default.target
